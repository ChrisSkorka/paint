        {
            "name": "paint (linux)",
            "request": "launch",
            "type": "dart",
            "deviceId": "linux",
        },
        {
            "name": "paint (chrome)",
            "request": "launch",
            "type": "dart",
            "deviceId": "chrome",
            "args": [
                "--web-port", "38459",
                "--web-browser-flag=--user-data-dir=${workspaceFolder}/.dart_tool/chrome-profile",
            ],
        },

